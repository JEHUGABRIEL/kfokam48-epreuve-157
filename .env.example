# Configuration locale — épreuve finale KFOKAM48.
#
# Ce fichier est un MODÈLE : il est commité, et il ne contient aucun secret.
# Copiez-le pour travailler :
#
#   cp .env.example .env
#
# `.env` n'est jamais commité (voir .gitignore). Les trois outils du dépôt lisent ce même fichier,
# à la racine, et n'en connaissent aucun autre :
#
#   - Spring Boot : spring.config.import (backend/src/main/resources/application.yml)
#                   → lancez l'API depuis backend/, où « ../.env » est bien la racine du dépôt
#   - Vite        : loadEnv (frontend/vite.config.ts)
#   - Docker      : lecture native de compose.yaml
#
# Aucun réglage n'est obligatoire. Sans `.env`, les valeurs par défaut d'application.yml et de
# compose.yaml s'appliquent : `docker compose up -d`, `cd backend && ./mvnw spring-boot:run` et
# `cd frontend && npm run dev` fonctionnent tels quels.

# --- Base de données (compose.yaml) -------------------------------------------
# Port sur l'hôte : 5433, pour ne pas entrer en conflit avec un PostgreSQL déjà installé sur 5432.
DB_PORT=5433
DB_URL=jdbc:postgresql://localhost:5433/epreuve
DB_USER=postgres
# Renseigné ici pour le développement local seulement. Un mot de passe de production se lit dans
# l'environnement du serveur, jamais dans un fichier du dépôt.
DB_PASSWORD=postgres

# --- API ----------------------------------------------------------------------
# 8080 par défaut. À changer si un autre service occupe déjà ce port sur le poste.
SERVER_PORT=8080

# --- Frontend (Vite) ----------------------------------------------------------
# Cible du proxy /api. Doit suivre SERVER_PORT : si l'API écoute sur 8081, écrivez 8081 ici.
VITE_API_TARGET=http://localhost:8080
